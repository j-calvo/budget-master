// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client-js"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String? // nullable for seeding or OAuth options
  createdAt DateTime @default(now())

  familyMembers FamilyMember[]
}

model Family {
  id         String   @id @default(uuid())
  name       String
  inviteCode String   @unique
  createdAt  DateTime @default(now())

  members      FamilyMember[]
  settings     Setting?
  accounts     Account[]
  creditCards  CreditCard[]
  categories   Category[]
  budgets      Budget[]
  loans        Loan[]
  currencies   Currency[]
  banks        Bank[]
  accountTypes AccountType[]
}

model FamilyMember {
  id        String   @id @default(uuid())
  userId    String
  familyId  String
  role      String   @default("MEMBER") // ADMIN or MEMBER
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([userId, familyId])
}

model Account {
  id          String   @id @default(uuid())
  familyId    String
  name        String
  type        String // checking, savings, investment
  currency    String   @default("USD")
  balance     Float    @default(0)
  institution String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model CreditCard {
  id           String   @id @default(uuid())
  familyId     String
  name         String
  limit        Float
  balance      Float    @default(0)
  dueDate      Int // day of the month (1-31)
  apr          Float
  currency     String   @default("USD")
  statementDay Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
}

model Category {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  type      String // income, fixed_expense, variable_expense, savings_goal
  color     String   @default("#3b82f6")
  createdAt DateTime @default(now())

  family       Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets      Budget[]
}

model Transaction {
  id           String   @id @default(uuid())
  accountId    String?
  creditCardId String?
  categoryId   String
  amount       Float
  date         DateTime @default(now())
  description  String
  payee        String?
  type         String // income, expense, transfer
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  account    Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creditCard CreditCard? @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  category   Category    @relation(fields: [categoryId], references: [id])
}

model Budget {
  id         String   @id @default(uuid())
  familyId   String
  categoryId String
  amount     Float
  currency   String   @default("CRC")
  payDay     Int? // 1-31 optional payday marker
  month      Int // 1-12
  year       Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  family   Family   @relation(fields: [familyId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id])

  @@unique([familyId, categoryId, month, year])
}

model Loan {
  id                   String   @id @default(uuid())
  familyId             String
  name                 String
  originalBalance      Float // original loan amount at start
  balance              Float // current remaining balance
  interestRate         Float // current APR
  termMonths           Int
  monthlyPayment       Float // computed: stored as cache
  insuranceCost        Float    @default(0)
  startDate            DateTime // beginning of the loan
  nextDueDate          DateTime // next payment due date
  isVariableRate       Boolean  @default(false)
  earlyPaymentStrategy String   @default("reduce_term") // 'reduce_term' | 'reduce_payment'
  aprHistory           String   @default("[]") // JSON array: [{date, apr}]
  currency             String   @default("USD")
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  family   Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  payments LoanPayment[]
}

model LoanPayment {
  id            String   @id @default(uuid())
  loanId        String
  type          String // 'installment' | 'early_payment'
  amount        Float // total amount paid
  principal     Float // principal portion
  interest      Float // interest portion
  insuranceCost Float    @default(0)
  paymentDate   DateTime @default(now())
  notes         String?  @default("")
  createdAt     DateTime @default(now())

  loan Loan @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Setting {
  id              String   @id @default(uuid())
  familyId        String   @unique
  defaultCurrency String   @default("USD")
  language        String   @default("en-US")
  fontFamily      String   @default("Outfit")
  payFrequency    String   @default("monthly")
  payDay          Int      @default(15)
  payDay2         Int? // For twice a month
  payDayOfWeek    Int? // For weekly (0-6)
  budgetStartDay  Int      @default(1)
  theme           String   @default("light")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
}

model Currency {
  id        String   @id @default(uuid())
  familyId  String
  code      String // e.g., 'USD', 'EUR'
  symbol    String // e.g., '$', '€'
  name      String // e.g., 'US Dollar'
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, code])
}

model Bank {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
}

model AccountType {
  id        String   @id @default(uuid())
  familyId  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, name])
}

model ExchangeRate {
  id        String   @id @default(uuid())
  base      String   @unique // e.g., 'USD'
  rates     String // JSON string: { 'EUR': 0.85, 'CRC': 540.0 }
  updatedAt DateTime @updatedAt
}
